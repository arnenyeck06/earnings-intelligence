# Anthropic (Claude) API key — used for answer generation, query rewriting, and re-ranking
ANTHROPIC_API_KEY=your-api-key-here

# Postgres / pgvector connection (see search/vector_store.py)
# When running via docker-compose, set POSTGRES_HOST=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=financial_rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag123

# Streamlit UI -> FastAPI backend URL
# When running via docker-compose, set API_URL=http://api:8000
API_URL=http://localhost:8000
